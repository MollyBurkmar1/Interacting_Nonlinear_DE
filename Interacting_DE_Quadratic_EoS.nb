Cell[CellGroupData[{

Cell[TextData[StyleBox["Taylor Expansion Around (1,1)", "Chapter",
 FontSize->28,
 FontColor->RGBColor[
  0.7607843137254902, 0.29411764705882354`, 0.08235294117647059]]], "Section",\

 CellChangeTimes->{{3.887794485950898*^9, 3.887794492608836*^9}, {
  3.892873558355391*^9, 3.892873566552358*^9}, {3.893252526241185*^9, 
  3.893252547790506*^9}, {3.893252699998537*^9, 3.8932527088480935`*^9}, {
  3.8932560906504774`*^9, 3.893256092996799*^9}, {3.943697860229647*^9, 
  3.943697865679613*^9}},ExpressionUUID->"ddcf3d71-5a9c-4242-8260-\
65d7a6855efb"],

Cell["\<\
We now know the system does admit critical points representing singularities, \
however the behaviour of trajectories around the singularity at (1,1) is not \
obvious, as the numerics break down when trajectories get close enough to the \
singularity. We want to understand if a separatrix exists between the fixed \
point where X = 3/(3+q), and the critical point at (1,1). If a separatrix \
does exists, then some trajectories will expand to the singularity at (1,1). \
If it does not, then all trajectories will be non-singular. 

To find if there is a separatrix to (1,1), we first Taylor expand the ODEs to \
second order around (1,1) and then find if an invariant line exists.

We find that when q < 3, a separatrix exists between the fixed point at X = \
3/(3+q) and the critical point (1,1), however when q > 3 it does not. \
Therefore when q > 3, all trajectories avoid a singularity.\
\>", "Text",
 CellChangeTimes->{{3.943526388665763*^9, 3.943526457463582*^9}, {
  3.943526854661158*^9, 3.943526892083956*^9}, {3.943697450343792*^9, 
  3.943697508667581*^9}, {3.943697917978325*^9, 3.9436980184605255`*^9}, {
  3.9606558079889603`*^9, 3.960655830576586*^9}, {3.9606564885706024`*^9, 
  3.960656530325943*^9}, {3.960656983866777*^9, 3.960657048745966*^9}, {
  3.960657082061093*^9, 3.960657086138744*^9}, {3.960659396293852*^9, 
  3.9606593985178013`*^9}, {3.96090285154043*^9, 
  3.9609029320334244`*^9}},ExpressionUUID->"099bf919-c8f1-4e64-8e4b-\
47912848fb5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "the", " ", "normalised", " ", "compact", " ", "dynamical",
      " ", "system", " ", "for", " ", "dark", " ", "energy", " ", "with", " ",
      "a", " ", "quadratic", " ", "equation", " ", "of", " ", "state"}], ",", 
    " ", "X", ",", " ", 
    RowBox[{"interacting", " ", "with", " ", "dark", " ", "matter"}], ",", 
    " ", "Z"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"We", " ", "multiply", " ", "by", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "X"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "-", "Z"}], ")"}], " ", "so", " ", "that", " ", "the", " ", 
    "fixed", " ", "point", " ", "at", " ", 
    RowBox[{"(", 
     RowBox[{"1", ",", "1"}], ")"}], " ", "becomes", " ", "an", " ", 
    "equilibrium", " ", "point", " ", "and", " ", "we", " ", "can", " ", 
    "Taylor", " ", "expand", " ", "around", " ", "it"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deX", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "3"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "X"}], ")"}], "^", "2"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"X", "/", 
             RowBox[{"(", 
              RowBox[{"1", "-", "X"}], ")"}]}], "-", "\[ScriptCapitalR]"}], 
           ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", "wx", "+", 
            RowBox[{"\[Epsilon]", "*", 
             RowBox[{"X", "/", 
              RowBox[{"(", 
               RowBox[{"1", "-", "X"}], ")"}]}]}]}], ")"}]}], "-", 
         RowBox[{"q", "*", "X", "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", "X"}], ")"}], "*", 
          RowBox[{"Z", "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "Z"}], ")"}]}]}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "X"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "Z"}], ")"}]}], ")"}]}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"deZ", "=", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "3"}], "*", "Z", "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", "Z"}], ")"}]}], " ", "+", " ", 
         RowBox[{"q", "*", "X", "*", "Z", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "Z"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "X"}], ")"}]}]}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "X"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", "Z"}], ")"}]}], ")"}]}], "]"}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.932118406019314*^9, 3.932118406797666*^9}, {
