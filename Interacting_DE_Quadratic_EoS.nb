    " ", 
    RowBox[{"dark", " ", "matter"}], ",", " ", "Z", ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "Hubble", " ", "expansion", " ", "function"}], 
    ",", " ", "Y"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deX", ":=", 
    RowBox[{
     RowBox[{"X", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", 
       RowBox[{"(", 
        RowBox[{"Y", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
