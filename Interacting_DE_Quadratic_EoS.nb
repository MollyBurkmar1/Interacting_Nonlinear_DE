       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "wx"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"X1", "[", "t", "]"}]}], ")"}]}], "+", 
         RowBox[{"\[Epsilon]", "*", 
          RowBox[{"X1", "[", "t", "]"}]}]}], ")"}]}], "-", 
      RowBox[{"q", "*", 
       RowBox[{"X1", "[", "t", "]"}], "*", 
       RowBox[{"(", 
