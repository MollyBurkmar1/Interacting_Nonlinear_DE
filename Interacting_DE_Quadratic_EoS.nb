Cell[CellGroupData[{

Cell[TextData[StyleBox["Curves Do Not Touch",
 FontWeight->"Bold"]], "Section",
 CellChangeTimes->{{3.897728232203933*^9, 3.897728256102563*^9}, 
   3.924150803032381*^9, {3.932628539255041*^9, 3.932628540019264*^9}, {
   3.935137663886513*^9, 3.935137665208909*^9}, 3.943080605603777*^9, {
   3.943429579176449*^9, 
   3.943429579695289*^9}},ExpressionUUID->"d2e91a43-d94d-5e43-8a31-\
793e6f6a1bdd"],

Cell["\<\
Trajectories are plotted on a constant X0-Z0 surface. k and Y0 differ for \
each trajectory in each phase space.\
\>", "Text",ExpressionUUID->"0dc918e7-51f8-fd4d-ac23-4665fd5e883c"],

Cell["\<\
Each case below corresponds to a different trajectory in the 2D phase space \
where the separatrix and zero acceleration curve do not touch. Trajectories \
in each phase space are plotted on a constant X0-Z0 surface, and k and Y0 \
differ for each trajectory. The number of Einstein points corresponds to the \
number of times the trajectory crosses the zero acceleration curve in the 2D \
phase space. For example, the surface plotted in the \[OpenCurlyQuote]No \
Einstein fixed points\[CloseCurlyQuote] case corresponds to a trajectory in \
the 2D phase space that never touches the zero acceleration curve and always \
accelerates. \
\>", "Text",
 CellChangeTimes->{{3.901264325071179*^9, 3.9012643978376718`*^9}, {
   3.901264521010646*^9, 3.901264530318124*^9}, 3.960899354909113*^9, {
   3.960908064402918*^9, 3.9609080957501736`*^9}, {3.9609081607690907`*^9, 
   3.9609083437379494`*^9}, {3.960908380072037*^9, 3.960908425003622*^9}, {
   3.9609610988776264`*^9, 
   3.960961130783201*^9}},ExpressionUUID->"1be0da49-7073-8840-87b7-\
9d3959187dcc"],

