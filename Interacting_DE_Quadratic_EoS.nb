Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Set", " ", "parameter", " ", "values"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[ScriptCapitalR]", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"\[Epsilon]", "=", 
     RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wx", "=", 
     RowBox[{"-", "0.8"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q", "=", "3.5"}], ";"}]}]}]], "Input",
 CellLabel->
