Cell[TextData[StyleBox["Interacting Dark Energy with a Quadratic EoS with a \
Late-Time Cosmological Constant",
 FontColor->RGBColor[
  0.7607843137254902, 0.29411764705882354`, 0.08235294117647059]]], "Title",
 CellChangeTimes->{{3.89325259655807*^9, 3.893252598919417*^9}, {
