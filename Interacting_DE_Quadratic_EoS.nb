    ",", " ", "Y"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deX", ":=", 
    RowBox[{
     RowBox[{"X", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", 
       RowBox[{"(", 
        RowBox[{"Y", "/", 
