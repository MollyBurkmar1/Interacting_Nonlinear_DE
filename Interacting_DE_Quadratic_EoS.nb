        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "wx"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", "X"}], ")"}]}], "+", 
         RowBox[{"\[Epsilon]", "*", "X"}]}], ")"}]}], "-", 
      RowBox[{"q", "*", "X", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "X"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"Z", "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", "Z"}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"Y", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Y", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], ")"}]}], ")"}]}]}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"deY", ":=", 
