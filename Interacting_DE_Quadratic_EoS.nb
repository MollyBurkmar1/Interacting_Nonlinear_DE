           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Y", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], ")"}]}], ")"}]}]}]}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"deY", ":=", 
    RowBox[{
     RowBox[{"Y", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Y", "^", "2"}]}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Y", "^", "2"}]}], ")"}], "^", 
