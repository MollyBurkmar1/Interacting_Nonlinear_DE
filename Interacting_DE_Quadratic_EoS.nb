}, Closed]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Set-Up for the 3D X-Y-Z System",
 FontSize->18]], "Subsubsection",ExpressionUUID->"5e7bebe5-c5b9-c54e-8f56-\
6cee9a9f5ee7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "the", " ", "compactified", " ", "dynamical", " ", 
     "system", " ", "for", " ", "dark", " ", "energy"}], ",", " ", "X", ",", 
    " ", 
    RowBox[{"dark", " ", "matter"}], ",", " ", "Z", ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "Hubble", " ", "expansion", " ", "function"}], 
    ",", " ", "Y"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deX", ":=", 
    RowBox[{
     RowBox[{"X", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", 
       RowBox[{"(", 
        RowBox[{"Y", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Y", "^", "2"}]}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"1", "/", "2"}], ")"}]}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"X", "-", 
         RowBox[{"\[ScriptCapitalR]", "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", "X"}], ")"}]}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "wx"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", "X"}], ")"}]}], "+", 
         RowBox[{"\[Epsilon]", "*", "X"}]}], ")"}]}], "-", 
      RowBox[{"q", "*", "X", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "X"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"Z", "/", 
         RowBox[{"(", 
          RowBox[{"1", "-", "Z"}], ")"}]}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"Y", "/", 
