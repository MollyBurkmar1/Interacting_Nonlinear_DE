Cell[CellGroupData[{

Cell["Compact Z - X Phase Space", "Subsubsection",
 CellChangeTimes->{{3.9237337772415137`*^9, 3.923733784898567*^9}, {
  3.923734468530003*^9, 
  3.923734471703017*^9}},ExpressionUUID->"4e6fef31-3038-45e8-9f1a-\
29bacb493faa"],

Cell["\<\
We define compact variables, so that we can see the dynamics up to infinity. \
X = 1 corresponds to x -> infinity, and Z = 1 corresponds to z -> infinity. \
From the compact equations below, we see that they system admits critical \
points (X\[CloseCurlyQuote] = 0, Z\[CloseCurlyQuote] = 0) at X = 1 and Z = 1, \
which represent singularities.\
\>", "Text",
 CellChangeTimes->{{3.960653658181967*^9, 3.960653703915344*^9}, {
  3.9606538675836697`*^9, 3.9606538946476*^9}, {3.960655428301916*^9, 
  3.9606554390245895`*^9}},ExpressionUUID->"666b5efa-b1f2-494f-a80e-\
f39ba97fc057"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "the", " ", "compact", " ", "dynamical", " ", "system", 
     " ", "for", " ", "dark", " ", "energy", " ", "with", " ", "a", " ", 
     "quadratic", " ", "equation", " ", "of", " ", "state"}], ",", " ", "X", 
    ",", " ", 
    RowBox[{"interacting", " ", "with", " ", "dark", " ", "matter"}], ",", 
    " ", "Z"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deX", ":=", 
    RowBox[{
     RowBox[{"X", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "X"}], ")"}], "^", "2"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"X", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "X"}], ")"}]}], "-", "\[ScriptCapitalR]"}], 
        ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", "wx", "+", 
         RowBox[{"\[Epsilon]", "*", 
          RowBox[{"X", "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", "X"}], ")"}]}]}]}], ")"}]}], "-", 
      RowBox[{"q", "*", "X", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "X"}], ")"}], "*", 
       RowBox[{"Z", "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "Z"}], ")"}]}]}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"deZ", ":=", 
    RowBox[{
     RowBox[{"Z", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", "Z", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "Z"}], ")"}]}], " ", "+", " ", 
      RowBox[{"q", "*", "X", "*", "Z", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", "Z"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", "X"}], ")"}]}]}]}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.88778352760754*^9, 3.887783529359799*^9}, {
   3.887783608967366*^9, 3.887783636614414*^9}, {3.887794567176412*^9, 
   3.887794595132979*^9}, {3.891414628624129*^9, 3.891414636327883*^9}, 
   3.893304880438389*^9, {3.92313577995991*^9, 3.923135822759281*^9}, {
