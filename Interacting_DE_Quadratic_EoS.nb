    RowBox[{"interacting", " ", "dark", " ", "matter"}], ",", " ", "z"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dex", ":=", 
    RowBox[{
     RowBox[{"x", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", 
       RowBox[{"(", 
        RowBox[{"x", "-", "\[ScriptCapitalR]"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "+", "wx", "+", 
         RowBox[{"\[Epsilon]", "*", "x"}]}], ")"}]}], "-", 
      RowBox[{"q", "*", "x", "*", "z"}]}]}]}], "\[IndentingNewLine]", 
   RowBox[{"dez", ":=", 
    RowBox[{
     RowBox[{"z", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", "z"}], " ", "+", " ", 
      RowBox[{"q", "*", "x", "*", "z"}]}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.88778352760754*^9, 3.887783529359799*^9}, {
