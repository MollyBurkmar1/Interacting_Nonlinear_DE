Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Define", " ", "the", " ", "compactified", " ", "dynamical", " ", 
     "system", " ", "for", " ", "dark", " ", "energy"}], ",", " ", "X", ",", 
    " ", 
    RowBox[{"dark", " ", "matter"}], ",", " ", "Z", ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "Hubble", " ", "expansion", " ", "function"}], 
    ",", " ", "Y"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deX", ":=", 
    RowBox[{
     RowBox[{"X", "'"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "3"}], "*", 
       RowBox[{"(", 
        RowBox[{"Y", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
