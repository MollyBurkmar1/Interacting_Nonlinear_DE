Cell[CellGroupData[{

Cell[TextData[StyleBox["Curves Touch",
 FontWeight->"Bold"]], "Section",
 CellChangeTimes->{{3.897728232203933*^9, 3.897728256102563*^9}, 
   3.924150803032381*^9, {3.932628539255041*^9, 3.932628540019264*^9}, {
   3.9348841321784477`*^9, 3.934884134450153*^9}, 3.943080602788769*^9, 
   3.960899355019705*^9},ExpressionUUID->"5bc64bbb-9b56-e24d-9e92-\
792f2e6f1f9e"],

Cell["\<\
Each case below corresponds to a different trajectory in the 2D phase space \
where the separatrix and zero acceleration curve touch. Trajectories in each \
phase space are plotted on a constant X0-Z0 surface, and k and Y0 differ for \
each trajectory. The number of Einstein points corresponds to the number of \
times the trajectory crosses the zero acceleration curve in the 2D phase \
space. For example, the surface plotted in the \[OpenCurlyQuote]No Einstein \
fixed points\[CloseCurlyQuote] case corresponds to a trajectory in the 2D \
phase space that always accelerates and expands towards (1,1). The surface \
plotted in the \[OpenCurlyQuote]Two Einstein fixed points\[CloseCurlyQuote] \
case corresponds to a trajectory in the 2D phase space which cross the zero \
acceleration curve twice and tends towards to the low energy attractor. \
\>", "Text",
 CellChangeTimes->{{3.901264325071179*^9, 3.9012643978376718`*^9}, {
   3.901264521010646*^9, 3.901264530318124*^9}, 3.960899354909113*^9, {
   3.960908064402918*^9, 3.9609080957501736`*^9}, {3.9609081607690907`*^9, 
   3.9609083437379494`*^9}, {3.960908380072037*^9, 3.960908425003622*^9}, {
   3.960960279750065*^9, 3.960960329688814*^9}, 
   3.9609604537502537`*^9},ExpressionUUID->"a7d5ff28-6586-d444-b4ad-\
3f4fdf7092ca"],

