    "t"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"deXt", ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"X1", "'"}], "[", "t", "]"}], "==", 
     RowBox[{
