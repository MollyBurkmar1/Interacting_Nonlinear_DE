Cell[CellGroupData[{

Cell[TextData[StyleBox["Curves Do Not Cross",
 FontWeight->"Bold"]], "Section",
 CellChangeTimes->{{3.897728232203933*^9, 3.897728256102563*^9}, 
   3.924150803032381*^9, {3.932628539255041*^9, 3.932628540019264*^9}, {
   3.935137663886513*^9, 3.935137665208909*^9}, 3.943080605603777*^9, 
   3.9608993550985966`*^9},ExpressionUUID->"7ba12929-1ae9-4d26-95af-\
c3fb03ba98ab"],

Cell["\<\
Each case below corresponds to a different trajectory in the 2D phase space \
where the separatrix and zero acceleration curve do not cross. Trajectories \
in each phase space are plotted on a constant X0-Z0 surface, and k and Y0 \
differ for each trajectory. The number of Einstein points corresponds to the \
number of times the trajectory crosses the zero acceleration curve in the 2D \
phase space. For example, the surfaces plotted in the \[OpenCurlyQuote]No \
Einstein fixed points\[CloseCurlyQuote] cases correspond to trajectories in \
the 2D phase space that always accelerates and never cross or touch the zero \
acceleration curve. The surface plotted in the \[OpenCurlyQuote]Two Einstein \
fixed points\[CloseCurlyQuote] case corresponds to a trajectory in the 2D \
phase space which cross the zero acceleration curve twice and tends towards \
to the low energy attractor. \
\>", "Text",
 CellChangeTimes->{{3.901264325071179*^9, 3.9012643978376718`*^9}, {
   3.901264521010646*^9, 3.901264530318124*^9}, 3.960899354909113*^9, {
   3.960908064402918*^9, 3.9609080957501736`*^9}, {3.9609081607690907`*^9, 
   3.9609083437379494`*^9}, {3.960908380072037*^9, 3.960908425003622*^9}, {
   3.960960279750065*^9, 3.960960329688814*^9}, {3.9609604001758327`*^9, 
   3.9609604432753735`*^9}},ExpressionUUID->"0f580327-558f-4841-b639-\
ed71c7ebdb0f"],

