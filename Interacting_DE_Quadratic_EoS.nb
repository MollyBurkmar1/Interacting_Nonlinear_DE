  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "Taylor", " ", "expanded", " ", "deX", " ", 
    "and", " ", "deZ", " ", "equations"}], "*)"}], "\[IndentingNewLine]", 
